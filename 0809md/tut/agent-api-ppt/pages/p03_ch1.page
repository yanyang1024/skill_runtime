pageType: chapter
background:
  type: gradient
  gradientType: linear
  angle: 135
  stops:
    - {position: 0, color: "#26233F"}
    - {position: 1, color: "#322A9E"}
elements:
  - elementId: big-num
    elementType: text
    bounds: [760, 160, 440, 200]
    content:
      fontSize: 150
      fontFamily: "alimamashuheiti"
      color: "#FFFFFF14"
      wrap: false
      align: [right, middle]
      text: "01"
  - elementId: kicker
    elementType: text
    bounds: [90, 252, 420, 26]
    content:
      fontSize: 15
      fontFamily: "MiSans"
      color: "#B9B4E0"
      letterSpacing: 4
      wrap: false
      align: [left, middle]
      text: CHAPTER 01
  - elementId: ch-bar
    elementType: shape
    bounds: [90, 292, 64, 5]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: ch-title
    elementType: text
    bounds: [90, 312, 640, 66]
    content:
      fontSize: 44
      fontFamily: "alimamashuheiti"
      color: "#FFFFFF"
      wrap: false
      align: [left, middle]
      text: 认知重构
  - elementId: ch-sub
    elementType: text
    bounds: [90, 396, 780, 70]
    content:
      fontSize: 19
      fontFamily: "MiSans"
      color: "#CFCAE8"
      lineHeight: 1.6
      align: [left, top]
      text: 模型 ≠ 你观察到的能力。传统 Chat API 暴露的是"说话能力"，下一代 Agent API 暴露的是"持续工作的能力"。
