{
  "id": "s2",
  "stageId": "stage_demo",
  "type": "interactive",
  "title": "缓存行为模拟：强缓存与协商缓存",
  "order": 2,
  "content": {
    "type": "interactive",
    "widgetType": "simulation",
    "description": "参数可调的过程模拟：滑块调 max-age、按钮切换强缓存/协商缓存/no-store，DOM/SVG 动画展示请求走向（本地命中零请求、协商 304、完整 200）。已实现 postMessage 导览桥。",
    "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<title>缓存行为模拟：强缓存与协商缓存</title>\n<style>\n  /* 针对 1280x720 逻辑视口设计，宿主用 transform: scale() 适配 */\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { width: 1280px; height: 720px; overflow: hidden;\n         font-family: -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n         background: #f6f4ee; color: #2c2a26; }\n  .page { width: 1280px; height: 720px; padding: 28px 40px; display: flex; flex-direction: column; }\n  header { margin-bottom: 16px; }\n  .eyebrow { font-size: 12px; letter-spacing: 2px; color: #5b7a5e; font-weight: 600; }\n  h1 { font-size: 26px; margin-top: 4px; }\n  h1 em { font-style: normal; color: #5b7a5e; }\n  .cols { flex: 1; display: flex; gap: 24px; min-height: 0; }\n\n  /* ---- 左侧控制面板 ---- */\n  .panel { width: 372px; background: #fff; border-radius: 14px; padding: 18px 20px;\n           box-shadow: 0 2px 14px rgba(44,42,38,.07); display: flex; flex-direction: column; gap: 14px; }\n  .panel h2 { font-size: 13px; color: #8a857c; font-weight: 600; letter-spacing: 1px; }\n  .modes { display: flex; gap: 8px; }\n  .mode-btn { flex: 1; border: 1px solid #d8d3c8; background: #f9f7f2; border-radius: 10px;\n              padding: 9px 4px; font-size: 13px; cursor: pointer; color: #55504a; }\n  .mode-btn.active { background: #5b7a5e; color: #fff; border-color: #5b7a5e; font-weight: 600; }\n  .slider-row { display: flex; align-items: center; gap: 12px; }\n  input[type=range] { flex: 1; accent-color: #5b7a5e; }\n  .val { min-width: 64px; text-align: right; font-family: \"SF Mono\", Consolas, monospace;\n         font-size: 14px; color: #2c2a26; }\n  .row-label { font-size: 13px; color: #6f6a60; margin-bottom: -6px; display: flex; justify-content: space-between; }\n  .row-label .cur { font-family: \"SF Mono\", Consolas, monospace; color: #5b7a5e; }\n  .actions { display: flex; gap: 8px; margin-top: auto; }\n  .actions button { flex: 1; border-radius: 10px; padding: 10px 6px; font-size: 14px;\n                    cursor: pointer; border: 1px solid #d8d3c8; background: #f9f7f2; }\n  .actions .primary { background: #5b7a5e; border-color: #5b7a5e; color: #fff; font-weight: 600; }\n  .actions .primary:disabled { opacity: .5; cursor: default; }\n  .stats { display: flex; gap: 8px; }\n  .stats .cell { flex: 1; background: #f6f4ee; border-radius: 10px; padding: 8px 4px; text-align: center; }\n  .stats .n { font-size: 18px; font-weight: 700; font-family: \"SF Mono\", Consolas, monospace; }\n  .stats .t { font-size: 11px; color: #8a857c; margin-top: 2px; }\n  .n.hit { color: #4d7c52; } .n.v304 { color: #8a6d3b; } .n.full { color: #b4552f; }\n\n  /* ---- 右侧模拟舞台 ---- */\n  .stage { flex: 1; display: flex; flex-direction: column; gap: 12px; min-width: 0; }\n  .canvas-wrap { background: #fff; border-radius: 14px; box-shadow: 0 2px 14px rgba(44,42,38,.07);\n                 padding: 10px 14px 4px; }\n  svg { display: block; width: 100%; height: auto; }\n  .flow-status { text-align: center; font-size: 14px; padding: 8px 0 10px; min-height: 38px;\n                 color: #55504a; }\n  .flow-status code { background: #eef2ec; border-radius: 4px; padding: 1px 8px;\n                      font-family: \"SF Mono\", Consolas, monospace; font-size: 13px; }\n  .log-wrap { flex: 1; background: #fff; border-radius: 14px; box-shadow: 0 2px 14px rgba(44,42,38,.07);\n              padding: 12px 18px; overflow: hidden; display: flex; flex-direction: column; }\n  .log-wrap h2 { font-size: 13px; color: #8a857c; letter-spacing: 1px; margin-bottom: 8px; }\n  #log-panel { flex: 1; overflow-y: auto; font-size: 12.5px; line-height: 1.7;\n               font-family: \"SF Mono\", Consolas, monospace; }\n  #log-panel .hit { color: #4d7c52; } #log-panel .v304 { color: #8a6d3b; }\n  #log-panel .full { color: #b4552f; } #log-panel .sys { color: #8a857c; }\n\n  /* 请求数据包动画 */\n  #packet { transition: cx .55s ease-in-out, cy .55s ease-in-out, opacity .3s; }\n  .node-box { fill: #f6f4ee; stroke: #d8d3c8; }\n  .node-box.cacheable { fill: #eef2ec; stroke: #5b7a5e; }\n  .node-label { font-size: 15px; fill: #2c2a26; font-weight: 600; text-anchor: middle; }\n  .node-sub { font-size: 11px; fill: #8a857c; text-anchor: middle; }\n  .wire { stroke: #cfc9bc; stroke-width: 2; fill: none; }\n  .wire-label { font-size: 11px; fill: #a39e93; text-anchor: middle; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header>\n    <div class=\"eyebrow\">HTTP 缓存机制 · 第 2 节 · 模拟实验</div>\n    <h1>缓存行为模拟：<em>max-age</em> 与请求走向</h1>\n  </header>\n\n  <div class=\"cols\">\n    <div class=\"panel\">\n      <h2>① 选择缓存策略</h2>\n      <div class=\"modes\">\n        <button class=\"mode-btn active\" id=\"preset-strong-btn\" data-mode=\"strong\">强缓存</button>\n        <button class=\"mode-btn\" id=\"preset-negotiate-btn\" data-mode=\"negotiate\">协商缓存</button>\n        <button class=\"mode-btn\" id=\"preset-nostore-btn\" data-mode=\"nostore\">no-store</button>\n      </div>\n\n      <h2>② 设置新鲜期 max-age</h2>\n      <div class=\"slider-row\">\n        <input type=\"range\" id=\"maxage-slider\" data-var=\"maxAge\" min=\"0\" max=\"300\" step=\"10\" value=\"120\">\n        <span class=\"val\" id=\"maxage-display\">120s</span>\n      </div>\n\n      <div class=\"row-label\"><span>副本已存放时间</span><span class=\"cur\" id=\"elapsed-display\">0s</span></div>\n      <div class=\"slider-row\">\n        <button id=\"time-btn\" class=\"mode-btn\">⏩ 时间快进 +60s</button>\n      </div>\n\n      <h2>③ 请求统计</h2>\n      <div class=\"stats\" id=\"stats-display\">\n        <div class=\"cell\"><div class=\"n hit\" id=\"stat-hit\">0</div><div class=\"t\">本地命中</div></div>\n        <div class=\"cell\"><div class=\"n v304\" id=\"stat-304\">0</div><div class=\"t\">304 协商</div></div>\n        <div class=\"cell\"><div class=\"n full\" id=\"stat-full\">0</div><div class=\"t\">完整下载</div></div>\n      </div>\n\n      <div class=\"actions\">\n        <button class=\"primary\" id=\"run-btn\">发起一次请求</button>\n        <button id=\"reset-btn\">重置</button>\n      </div>\n    </div>\n\n    <div class=\"stage\">\n      <div class=\"canvas-wrap\">\n        <svg viewBox=\"0 0 860 300\" aria-label=\"请求走向示意图\">\n          <!-- 连线 -->\n          <path class=\"wire\" d=\"M 180 150 L 340 150\" />\n          <path class=\"wire\" d=\"M 520 150 L 680 150\" />\n          <path class=\"wire\" d=\"M 430 210 L 430 240 L 130 240 L 130 196\" stroke-dasharray=\"5 4\" />\n          <text class=\"wire-label\" x=\"260\" y=\"140\">有副本？</text>\n          <text class=\"wire-label\" x=\"600\" y=\"140\">条件请求 / 完整请求</text>\n          <text class=\"wire-label\" x=\"280\" y=\"232\">304 → 刷新本地副本新鲜期</text>\n          <!-- 节点 -->\n          <rect class=\"node-box\" x=\"40\" y=\"100\" width=\"140\" height=\"96\" rx=\"14\" />\n          <text class=\"node-label\" x=\"110\" y=\"142\">浏览器</text>\n          <text class=\"node-sub\" x=\"110\" y=\"164\">发起请求</text>\n          <rect class=\"node-box cacheable\" x=\"340\" y=\"100\" width=\"180\" height=\"96\" rx=\"14\" id=\"cache-node\" />\n          <text class=\"node-label\" x=\"430\" y=\"138\">本地缓存</text>\n          <text class=\"node-sub\" x=\"430\" y=\"160\" id=\"cache-state\">（空）</text>\n          <rect class=\"node-box\" x=\"680\" y=\"100\" width=\"140\" height=\"96\" rx=\"14\" />\n          <text class=\"node-label\" x=\"750\" y=\"142\">源服务器</text>\n          <text class=\"node-sub\" x=\"750\" y=\"164\">style.css · v1</text>\n          <!-- 请求数据包 -->\n          <circle id=\"packet\" cx=\"110\" cy=\"150\" r=\"10\" fill=\"#5b7a5e\" opacity=\"0\" />\n        </svg>\n        <div class=\"flow-status\" id=\"flow-status\">就绪：点击「发起一次请求」开始实验</div>\n      </div>\n\n      <div class=\"log-wrap\">\n        <h2>请求日志</h2>\n        <div id=\"log-panel\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script type=\"application/json\" id=\"widget-config\">\n{\"type\": \"simulation\", \"concept\": \"HTTP 缓存请求走向\", \"variables\": [\"maxAge\"], \"presets\": [\"strong\", \"negotiate\", \"nostore\"]}\n</script>\n\n<script>\n/* ================= 模拟状态（sandbox 内无 localStorage，全部存内存） ================= */\nvar state = {\n  mode: \"strong\",      // strong=强缓存 / negotiate=协商缓存 / nostore=不缓存\n  maxAge: 120,         // 新鲜期（秒），由 maxage-slider 驱动\n  elapsed: 0,          // 副本已存放秒数，由 time-btn 快进\n  hasCopy: false,      // 本地是否已有副本\n  reqNo: 0,            // 请求序号\n  stats: { hit: 0, v304: 0, full: 0 }\n};\nvar animating = false;\n\nvar $ = function (id) { return document.getElementById(id); };\nvar packet = $(\"packet\");\n\nfunction fmt(s) { return s + \"s\"; }\n\nfunction log(cls, msg) {\n  var panel = $(\"log-panel\");\n  var line = document.createElement(\"div\");\n  line.className = cls;\n  line.textContent = msg;\n  panel.appendChild(line);\n  panel.scrollTop = panel.scrollHeight;\n}\n\nfunction refreshDisplays() {\n  $(\"maxage-display\").textContent = fmt(state.maxAge);\n  $(\"elapsed-display\").textContent = fmt(state.elapsed);\n  $(\"stat-hit\").textContent = state.stats.hit;\n  $(\"stat-304\").textContent = state.stats.v304;\n  $(\"stat-full\").textContent = state.stats.full;\n  $(\"cache-state\").textContent = state.hasCopy\n    ? \"副本已存 \" + state.elapsed + \"s（max-age=\" + state.maxAge + \"s）\"\n    : \"（空）\";\n}\n\n/* 数据包移动：x 坐标序列依次播放，最后执行 done */\nfunction movePacket(xs, done) {\n  packet.setAttribute(\"opacity\", \"1\");\n  var i = 0;\n  (function step() {\n    if (i >= xs.length) { done && done(); return; }\n    packet.setAttribute(\"cx\", xs[i]);\n    i++;\n    setTimeout(step, 600);\n  })();\n}\n\nfunction hidePacket() { packet.setAttribute(\"opacity\", \"0\"); }\n\n/* ================= 一次请求的判定逻辑 ================= */\nfunction runRequest() {\n  if (animating) return;\n  animating = true;\n  $(\"run-btn\").disabled = true;\n  state.reqNo++;\n  var tag = \"#\" + state.reqNo + \" \";\n\n  if (state.mode === \"nostore\") {\n    /* no-store：任何缓存都不许存，永远完整请求 */\n    $(\"flow-status\").innerHTML = tag + \"<code>Cache-Control: no-store</code> —— 不许缓存，直接访问源服务器\";\n    log(\"sys\", tag + \"GET /style.css（no-store，跳过本地缓存）\");\n    movePacket([180, 340, 520, 680, 520, 340, 180], function () {\n      hidePacket();\n      state.stats.full++;\n      state.hasCopy = false;\n      $(\"flow-status\").innerHTML = tag + \"服务器返回 <code>200 OK</code>（完整响应体），且副本不落地\";\n      log(\"full\", tag + \"← 200 OK（完整下载，不缓存）\");\n      finish();\n    });\n    return;\n  }\n\n  if (!state.hasCopy) {\n    /* 首次请求：本地无副本，必然完整下载 */\n    var head = state.mode === \"strong\"\n      ? \"Cache-Control: max-age=\" + state.maxAge\n      : \"Cache-Control: no-cache · ETag: \\\"v1\\\"\";\n    $(\"flow-status\").innerHTML = tag + \"本地缓存为空，首次请求源服务器\";\n    log(\"sys\", tag + \"GET /style.css（缓存为空）\");\n    movePacket([180, 340, 520, 680, 520, 340, 180], function () {\n      hidePacket();\n      state.stats.full++;\n      state.hasCopy = true;\n      state.elapsed = 0;\n      $(\"flow-status\").innerHTML = tag + \"服务器返回 <code>200 OK</code> + <code>\" + head + \"</code>，副本存入本地缓存\";\n      log(\"full\", tag + \"← 200 OK（完整下载，副本已缓存）\");\n      finish();\n    });\n    return;\n  }\n\n  var fresh = state.elapsed < state.maxAge;\n  if (state.mode === \"strong\" && fresh) {\n    /* 强缓存命中：零网络往返 */\n    state.stats.hit++;\n    $(\"flow-status\").innerHTML = tag + \"副本新鲜（\" + state.elapsed + \"s &lt; max-age \" + state.maxAge + \"s），直接使用本地副本\";\n    log(\"hit\", tag + \"→ 本地命中：200 OK（from disk cache），未发网络请求\");\n    movePacket([180, 340, 180], function () {\n      hidePacket();\n      $(\"flow-status\").innerHTML = tag + \"<code>200 OK (from disk cache)</code> —— 零网络往返，毫秒级完成\";\n      finish();\n    });\n    return;\n  }\n\n  if (state.mode === \"strong\" && !fresh) {\n    /* 强缓存过期：重新完整下载 */\n    $(\"flow-status\").innerHTML = tag + \"副本已过期（\" + state.elapsed + \"s ≥ max-age \" + state.maxAge + \"s），重新下载\";\n    log(\"sys\", tag + \"GET /style.css（副本过期，重新请求）\");\n    movePacket([180, 340, 520, 680, 520, 340, 180], function () {\n      hidePacket();\n      state.stats.full++;\n      state.elapsed = 0;\n      $(\"flow-status\").innerHTML = tag + \"服务器返回 <code>200 OK</code>（完整响应体），副本新鲜期重置\";\n      log(\"full\", tag + \"← 200 OK（完整下载，新鲜期重置为 0s）\");\n      finish();\n    });\n    return;\n  }\n\n  /* negotiate：每次用前带 If-None-Match 验证（这里服务器资源未变，返回 304） */\n  $(\"flow-status\").innerHTML = tag + \"带 <code>If-None-Match: \\\"v1\\\"</code> 发起条件请求\";\n  log(\"sys\", tag + \"GET /style.css  If-None-Match: \\\"v1\\\"（协商验证）\");\n  movePacket([180, 340, 520, 680], function () {\n    state.stats.v304++;\n    state.elapsed = 0;\n    $(\"flow-status\").innerHTML = tag + \"ETag 一致，服务器返回 <code>304 Not Modified</code>（无响应体）\";\n    log(\"v304\", tag + \"← 304 Not Modified（资源未变，刷新副本新鲜期）\");\n    movePacket([520, 340, 130, 130], function () {\n      hidePacket();\n      finish();\n    });\n  });\n}\n\nfunction finish() {\n  animating = false;\n  $(\"run-btn\").disabled = false;\n  refreshDisplays();\n}\n\n/* ================= 控件事件 ================= */\ndocument.querySelector(\".modes\").addEventListener(\"click\", function (e) {\n  var btn = e.target.closest(\".mode-btn\");\n  if (!btn) return;\n  this.querySelectorAll(\".mode-btn\").forEach(function (b) { b.classList.remove(\"active\"); });\n  btn.classList.add(\"active\");\n  state.mode = btn.dataset.mode;\n  var hint = {\n    strong: \"策略：强缓存（Cache-Control: max-age）——新鲜期内零请求\",\n    negotiate: \"策略：协商缓存（no-cache + ETag）——每次用前向服务器验证\",\n    nostore: \"策略：no-store —— 完全不缓存，每次完整下载\"\n  }[state.mode];\n  $(\"flow-status\").textContent = hint;\n  log(\"sys\", \"· 切换策略 → \" + hint);\n});\n\n$(\"maxage-slider\").addEventListener(\"input\", function () {\n  state.maxAge = parseInt(this.value, 10);\n  refreshDisplays();\n});\n\n$(\"time-btn\").addEventListener(\"click\", function () {\n  if (!state.hasCopy) {\n    log(\"sys\", \"· 本地还没有副本，快进时间无意义——先发起一次请求吧\");\n    return;\n  }\n  state.elapsed += 60;\n  log(\"sys\", \"· 时间快进 60s：副本已存放 \" + state.elapsed + \"s\" +\n    (state.elapsed >= state.maxAge ? \"（已过期）\" : \"（仍新鲜）\"));\n  refreshDisplays();\n});\n\n$(\"run-btn\").addEventListener(\"click\", runRequest);\n\n$(\"reset-btn\").addEventListener(\"click\", function () {\n  state.maxAge = 120;\n  state.elapsed = 0;\n  state.hasCopy = false;\n  state.reqNo = 0;\n  state.stats = { hit: 0, v304: 0, full: 0 };\n  $(\"maxage-slider\").value = 120;\n  $(\"log-panel\").innerHTML = \"\";\n  $(\"flow-status\").textContent = \"已重置：点击「发起一次请求」开始实验\";\n  log(\"sys\", \"· 实验已重置\");\n  refreshDisplays();\n});\n\nrefreshDisplays();\nlog(\"sys\", \"· 模拟器就绪。试试：强缓存下先发一次请求，再连续发起观察本地命中；然后快进时间让副本过期。\");\n\n/* ===== postMessage 桥：监听宿主下发的导览消息（参考 widget-contract.md） ===== */\nwindow.addEventListener('message', function (event) {\n  /* 宿主消息形如 {type:'HIGHLIGHT_ELEMENT', target:'#reset-btn', content:'…', state:{…}} */\n  var data = event.data || {};\n  var type = data.type;\n  var target = data.target;   // CSS 选择器\n  var content = data.content; // 批注文本\n  var st = data.state;        // 可选：状态对象\n  switch (type) {\n    case 'SET_WIDGET_STATE':\n      /* 按命名约定把 state 里的每个键写回对应控件并触发 input 事件 */\n      if (st) {\n        Object.keys(st).forEach(function (key) {\n          var el = document.getElementById(key + '-slider') ||\n                   document.querySelector('[data-var=\"' + key + '\"]');\n          if (el) {\n            el.value = st[key];\n            el.dispatchEvent(new Event('input', { bubbles: true }));\n          }\n        });\n      }\n      break;\n    case 'HIGHLIGHT_ELEMENT':\n      var highlightEl = document.querySelector(target);\n      if (highlightEl) {\n        highlightEl.style.outline = '3px solid rgba(139, 92, 246, 0.8)';\n        highlightEl.style.outlineOffset = '4px';\n        highlightEl.style.animation = 'pulse-highlight 2s infinite';\n        setTimeout(function () {\n          highlightEl.style.outline = '';\n          highlightEl.style.animation = '';\n        }, 3000);\n      }\n      break;\n    case 'ANNOTATE_ELEMENT':\n      var annotateEl = document.querySelector(target);\n      if (annotateEl && content) {\n        var rect = annotateEl.getBoundingClientRect();\n        var tooltip = document.createElement('div');\n        tooltip.className = 'teacher-annotation';\n        tooltip.style.cssText =\n          'position:fixed; top:' + (rect.top - 40) + 'px; left:' + rect.left + 'px;' +\n          'background:rgba(139,92,246,0.95); color:white; padding:8px 12px;' +\n          'border-radius:8px; font-size:14px; z-index:1000; animation:fadeIn 0.3s;';\n        tooltip.textContent = content;\n        document.body.appendChild(tooltip);\n        setTimeout(function () { tooltip.remove(); }, 4000);\n      }\n      break;\n    case 'REVEAL_ELEMENT':\n      var revealEl = document.querySelector(target);\n      if (revealEl) {\n        revealEl.style.display = '';\n        revealEl.style.opacity = '1';\n      }\n      break;\n  }\n});\nvar bridgeStyle = document.createElement('style');\nbridgeStyle.textContent =\n  '@keyframes pulse-highlight { 0%, 100% { outline-color: rgba(139, 92, 246, 0.8); }' +\n  ' 50% { outline-color: rgba(139, 92, 246, 0.4); } }' +\n  '@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); }' +\n  ' to { opacity: 1; transform: translateY(0); } }';\ndocument.head.appendChild(bridgeStyle);\n</script>\n</body>\n</html>\n"
  },
  "actions": [
    {
      "actionName": "spotlight",
      "params": {
        "selector": "#maxage-slider"
      }
    },
    {
      "actionName": "annotate",
      "params": {
        "selector": "#maxage-slider",
        "text": "拖动滑块设置副本新鲜期 max-age（秒）"
      }
    },
    {
      "actionName": "wait",
      "params": {
        "ms": 800
      }
    },
    {
      "actionName": "spotlight",
      "params": {
        "selector": "#preset-negotiate-btn"
      }
    },
    {
      "actionName": "annotate",
      "params": {
        "selector": "#preset-negotiate-btn",
        "text": "切到协商缓存，观察 If-None-Match 与 304"
      }
    },
    {
      "actionName": "spotlight",
      "params": {
        "selector": "#run-btn"
      }
    },
    {
      "actionName": "annotate",
      "params": {
        "selector": "#run-btn",
        "text": "点击发起请求，观察数据包走向与日志"
      }
    },
    {
      "actionName": "next",
      "params": {}
    }
  ]
}