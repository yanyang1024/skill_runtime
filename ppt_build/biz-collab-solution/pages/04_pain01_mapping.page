    bounds: [424, 218, 456, 64]
    content:
      align: [left, middle]
      text: |
        <p><span style="font-size:13px; color:$ink;"><strong>业务层</strong></span><span style="font-size:11px; color:$faint;">　本业务域特有</span></p>
        <p style="margin-top:4px"><span style="font-size:11px; color:#3A423C;">业务术语 → 表 / 字段 / 接口一一映射，专门标注「典型口径陷阱」</span></p>
  - elementId: layer-arr2
