# No key: a clearly labelled rule-driven demo. A key: real Responses calls.
APP_MODE=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_ROUNDS=8

# Local, single-process sample application.
APP_HOST=127.0.0.1
APP_PORT=8000
