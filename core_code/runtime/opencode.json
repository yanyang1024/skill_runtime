{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-v1/glm4:9b",
  "small_model": "local-v1/glm4:9b",
  "provider": {
    "local-v1": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama GLM-4 (OpenAI 兼容)",
      "options": {
        "baseURL": "http://172.24.16.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "glm4:9b": {
          "name": "GLM-4 9B (Ollama)"
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "git push *": "deny"
    },
    "skill": {
      "*": "allow"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "__pycache__/**"
    ]
  }
}
