{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "observed-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Observed OpenAI-compatible endpoint",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "local-proxy"
      },
      "models": {
        "your-model-id": {
          "name": "Your observed model"
        }
      }
    }
  }
}
