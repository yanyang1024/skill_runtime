  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", ".opencode/lib/**/*.ts"],
  "exclude": ["test/**/*.ts", ".opencode/plugins/**/*.ts"]
}
