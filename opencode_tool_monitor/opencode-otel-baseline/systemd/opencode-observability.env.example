# Collector mode: upstream (recommended) or local-file (offline audit only).
OTELCOL_CONFIG=/opt/opencode-observability/otelcol/config-upstream.yaml
OTEL_STORAGE_DIR=/var/lib/opencode-observability/queue
OTEL_FILE_DIR=/var/lib/opencode-observability/archive
OTEL_UPSTREAM_ENDPOINT=https://otel-gateway.internal.example

# Both the OpenCode plugin and model proxy send to the loopback Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=opencode-agent
DEPLOYMENT_ENVIRONMENT=production
OTEL_METRIC_EXPORT_INTERVAL=10000

# Capture policy. Prefer off in production; use redacted only after review.
AGENT_OTEL_CAPTURE_CONTENT=off
AGENT_OTEL_MAX_CONTENT_CHARS=65536
AGENT_OTEL_INJECT_PRIVATE_HEADERS=1
AGENT_TASK_ID=
AGENT_ATTEMPT=1

# Model proxy.
MODEL_PROXY_PORT=8787
MODEL_PROXY_UPSTREAM_BASE_URL=https://llm-gateway.internal.example
MODEL_PROXY_UPSTREAM_API_KEY=
MODEL_PROXY_PROVIDER_NAME=internal
MODEL_PRICES_JSON={}

# Health script thresholds.
HEALTH_CHECK_TIMEOUT_MS=3000
OTELCOL_QUEUE_WARNING_RATIO=0.7
OTELCOL_QUEUE_CRITICAL_RATIO=0.9
