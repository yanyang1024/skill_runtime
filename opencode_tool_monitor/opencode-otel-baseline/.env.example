# Recommended: send to the local otelcol-contrib process. Direct mode may point
# this at an existing internal OTLP/HTTP endpoint instead.
# The code appends /v1/traces, /v1/metrics and /v1/logs.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=opencode-agent
DEPLOYMENT_ENVIRONMENT=production

# off | redacted | full. Production should normally use off.
AGENT_OTEL_CAPTURE_CONTENT=off
AGENT_OTEL_MAX_CONTENT_CHARS=65536

# Set only when OpenCode points to the local model proxy below. Private x-agent-*
# headers are stripped before the proxy forwards the request upstream.
AGENT_OTEL_INJECT_PRIVATE_HEADERS=1
AGENT_TASK_ID=
AGENT_ATTEMPT=1

MODEL_PROXY_PORT=8787
MODEL_PROXY_UPSTREAM_BASE_URL=https://api.openai.com
MODEL_PROXY_UPSTREAM_API_KEY=
MODEL_PROXY_PROVIDER_NAME=openai

# Optional cost calculation. OpenCode's own assistant-message cost remains the
# preferred source when it is present.
# MODEL_PRICES_JSON={"gpt-4.1":{"input_per_1m":2,"output_per_1m":8,"cached_input_per_1m":0.5}}
MODEL_PRICES_JSON={}
