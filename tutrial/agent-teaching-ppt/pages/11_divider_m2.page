    elementType: text
    bounds: [64, 268, 700, 18]
    content:
      style: "$kicker"
      text: 模块二 · 第三部分
  - elementId: title
    elementType: text
    bounds: [64, 292, 832, 44]
    content:
      fontSize: 30
      color: "$ink"
